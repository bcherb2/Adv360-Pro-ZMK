#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        tap_dance_sft: tap_dance_sft {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_SFT";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };

        HRML: HRML {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <125>;
            flavor = "balanced";
            require-prior-idle-ms = <0>;
            quick-tap-ms = <125>;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 27 26 25 24 23 22 21 39 40 41 42 43 44 45 59 58 57 56 55 54 71 72 73 74 75>;
        };

        HRMR: HRMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <175>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64>;
        };
    };

    macros {
        term_copy: term_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "TERM_COPY";
        };

        term_paste: term_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "TERM_PASTE";
        };

        command_bar: command_bar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp P>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "COMMAND_BAR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1        &kp N2         &kp N3        &kp N4         &kp N5  &tog 1                                                             &mo 3            &kp N6  &kp N7         &kp N8        &kp N9         &kp N0           &kp MINUS
&kp TAB         &kp Q         &kp W          &kp E         &kp R          &kp T   &bl BL_INC                                                         &kp C_VOLUME_UP  &kp Y   &kp U          &kp I         &kp O          &kp P            &kp BSLH
&kp ESC         &HRML A LGUI  &HRML S LCTRL  &HRML D LALT  &HRML F LSHFT  &kp G   &kp TILDE      &kp LCTRL     &kp LALT      &kp LGUI   &kp RCTRL    &kp MINUS        &kp H   &HRMR J RSHFT  &HRMR K RALT  &HRMR L RCTRL  &HRMR SEMI RGUI  &kp SQT
&tap_dance_sft  &kp Z         &kp X          &kp C         &kp V          &kp B                                &kp HOME      &kp PG_UP                                &kp N   &kp M          &kp COMMA     &kp DOT        &kp FSLH         &kp RSHFT
&mo 2           &kp GRAVE     &none          &kp LEFT      &kp RIGHT              &kp BACKSPACE  &lt 2 DELETE  &kp END       &kp PG_DN  &lt 2 ENTER  &lt 1 SPACE              &kp UP         &kp DOWN      &kp LBKT       &kp RBKT         &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2  &kp N3    &kp N4     &kp N5  &trans                                                     &mo 3            &kp N6  &kp KP_NUM  &kp KP_EQUAL     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W   &kp E     &kp R      &kp T   &bl BL_INC                                                 &kp C_VOLUME_UP  &kp Y   &kp KP_N7   &kp KP_N8        &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S   &kp D     &kp F      &kp G   &bl BL_DEC  &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &kp C_VOL_DN     &kp H   &kp KP_N4   &kp KP_N5        &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X   &kp C     &kp V      &kp B                          &kp HOME      &kp PG_UP                              &kp N   &kp KP_N1   &kp KP_N2        &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &none   &kp LEFT  &kp RIGHT          &none       &none      &kp END       &kp PG_DN  &none      &none                    &kp UP      &kp KP_NUMBER_0  &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2         &kp F3          &kp F4            &kp F5                &kp F6     &tog 1                                      &mo 3   &kp F7     &kp F8                 &kp F9             &kp F10          &kp F11           &kp F12
&trans  &trans         &trans          &trans            &trans                &trans     &none                                       &none   &trans     &trans                 &trans             &trans           &trans            &trans
&trans  &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp TILDE  &none   &trans  &trans      &trans  &trans  &none   &kp MINUS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp GREATER_THAN  &trans
&trans  &trans         &trans          &term_copy        &term_paste           &trans                     &trans      &trans                  &trans     &trans                 &trans             &trans           &trans            &trans
&trans  &trans         &command_bar    &trans            &trans                           &trans  &trans  &trans      &trans  &trans  &trans             &trans                 &trans             &trans           &trans            &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                                             &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
